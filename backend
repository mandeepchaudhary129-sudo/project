#include <stdio.h>
#include <string.h>

// Structure for a Food Item
struct FoodItem {
    int id;
    char name[30];
    int price;
};

int main() {
    // 25 Predefined Food Items
    struct FoodItem menu[25] = {
        {1, "Veg Burger", 90}, {2, "Cheese Pizza", 220}, {3, "French Fries", 70},
        {4, "Veg Momos", 100}, {5, "Paneer Roll", 120}, {6, "Chicken Biryani", 180},
        {7, "Veg Fried Rice", 130}, {8, "Hakka Noodles", 120}, {9, "Masala Dosa", 90},
        {10, "Idli Sambar", 70}, {11, "Chole Bhature", 110}, {12, "Dal Makhani", 150},
        {13, "Shahi Paneer", 170}, {14, "Butter Naan", 35}, {15, "Tandoori Roti", 20},
        {16, "Cold Coffee", 90}, {17, "Mango Shake", 100}, {18, "Lemon Soda", 50},
        {19, "Masala Chai", 30}, {20, "Gulab Jamun", 50}, {21, "Vanilla Ice Cream", 60},
        {22, "Chocolate Brownie", 110}, {23, "Veg Sandwich", 80}, {24, "White Sauce Pasta", 160},
        {25, "Spring Rolls", 110}
    };

    int choice, foodId, qty;
    int cartItems[25] = {0}; // Stores quantities ordered for each item ID
    int totalAmount = 0;

    printf("========================================\n");
    printf("      WELCOME TO FOOD ORDERING MANAGEMENT SYSTEM    \n");
    printf("========================================\n");

    while (1) {
        printf("\n--- MAIN MENU ---\n");
        printf("1. View Food Menu (25 Items)\n");
        printf("2. Place Order / Add to Cart\n");
        printf("3. View Bill / Checkout\n");
        printf("4. Exit System\n");
        printf("Enter your choice (1-4): ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("\n--- FOOD MENU LIST ---\n");
                for (int i = 0; i < 25; i++) {
                    printf("[%d] %s - Rs. %d\n", menu[i].id, menu[i].name, menu[i].price);
                }
                break;

            case 2:
                printf("\nEnter Food ID (1-25) to order: ");
                scanf("%d", &foodId);
                if (foodId >= 1 && foodId <= 25) {
                    printf("Enter Quantity for %s: ", menu[foodId - 1].name);
                    scanf("%d", &qty);
                    if (qty > 0) {
                        cartItems[foodId - 1] += qty;
                        printf("Successfully added to your order!\n");
                    } else {
                        printf("Invalid quantity!\n");
                    }
                } else {
                    printf("Invalid Food ID! Please check the menu.\n");
                }
                break;

            case 3:
                totalAmount = 0;
                printf("\n========================================\n");
                printf("          FOOD ORDERING MANAGEMENT SYSTEM - TAX BILL         \n");
                printf("========================================\n");
                printf("Item Name\t\tQty\tPrice\n");
                printf("----------------------------------------\n");
                
                for (int i = 0; i < 25; i++) {
                    if (cartItems[i] > 0) {
                        int cost = menu[i].price * cartItems[i];
                        totalAmount += cost;
                        printf("%-18s\t%d\tRs. %d\n", menu[i].name, cartItems[i], cost);
                    }
                }
                
                if (totalAmount == 0) {
                    printf("Your cart is currently empty!\n");
                } else {
                    int tax = totalAmount * 5 / 105; // Quick approximate tax breakdown or addition
                    printf("----------------------------------------\n");
                    printf("Grand Total (Incl. Taxes): Rs. %d\n", totalAmount);
                }
                printf("========================================\n");
                break;

            case 4:
                printf("\nThank you for using food ordering management system Project. Goodbye!\n");
                return 0;

            default:
                printf("Invalid choice! Please select between 1 and 4.\n");
        }
    }
    return 0;
}
